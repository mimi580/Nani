# ── REQUIRED ──────────────────────────────────────────────
DERIV_API_TOKEN=your_token_here
DERIV_APP_ID=1089
SYMBOL=R_100

# ── SIGNAL THRESHOLDS ─────────────────────────────────────
# Minimum Bayes probability to fire trade (0.58 = 86% WR in backtest)
PROB_THRESH=0.58
# Z-score threshold — how dominant the pattern must be
ZSCORE_THRESH=1.0
# Rolling window for Z-score calculation
ZSCORE_WINDOW=50
# Markov transition memory window
MARKOV_WINDOW=100
# Ticks before trading starts
MIN_WARMUP=60
# Ticks between trades
COOLDOWN_TICKS=1

# ── SEEDED PRIORS (from R_100 monitor data — do not change) ──
PRIOR_ODD=0.5551
MK_ODD_GIVEN_EVEN=0.5576
MK_ODD_GIVEN_ODD=0.5536

# ── RISK ──────────────────────────────────────────────────
INITIAL_STAKE=0.35
MARTINGALE_MUL=1.65
MAX_LOSSES=4
TARGET_PROFIT=15.0
STOP_LOSS=30.0

# ── CIRCUIT BREAKER ───────────────────────────────────────
CB_LIMIT=4
CB_PAUSE=300
